:root {
  color-scheme: dark;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  background: #071019;
  color: #e8f1f7;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 80% 0%, #12304a 0, transparent 32rem),
    #071019;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 250px;
  padding: 28px 20px;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(4, 12, 20, 0.92);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 42px;
}

.brand-mark {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid #5fb9f6;
  border-radius: 12px;
  background: rgba(48, 146, 214, 0.15);
  color: #87ceff;
  font-weight: 800;
}

.brand h1,
.brand p {
  margin: 0;
}

.brand h1 {
  font-size: 19px;
}

.brand p {
  margin-top: 3px;
  color: #8296a6;
  font-size: 12px;
}

nav {
  display: grid;
  gap: 7px;
}

nav a {
  padding: 12px 14px;
  border-radius: 10px;
  color: #91a4b4;
  text-decoration: none;
}

nav a:hover,
nav a.active {
  background: rgba(58, 157, 226, 0.14);
  color: #dff3ff;
}

main {
  margin-left: 250px;
  padding: 34px;
}

.topbar,
.panel-heading,
.service {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar {
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 6px;
  color: #68bff8;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

h2,
h3,
h4 {
  margin: 0;
}

h2 {
  font-size: 30px;
}

.connection {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #a8bac7;
}

#connection-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #e5a84b;
  box-shadow: 0 0 14px currentColor;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.card,
.panel {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(10, 25, 38, 0.78);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(14px);
}

.card {
  min-height: 150px;
  padding: 22px;
  border-radius: 16px;
}

.card-label {
  margin: 0 0 22px;
  color: #8398a9;
  font-size: 13px;
}

.card strong {
  display: block;
  overflow-wrap: anywhere;
  font-size: 28px;
}

#hostname {
  font-size: clamp(18px, 1.7vw, 28px);
}

.card p:last-child {
  margin-bottom: 0;
  color: #738897;
  font-size: 13px;
}

.panel {
  margin-top: 22px;
  padding: 24px;
  border-radius: 18px;
}

.panel-heading {
  margin-bottom: 22px;
}

button {
  padding: 10px 16px;
  border: 1px solid rgba(105, 193, 251, 0.45);
  border-radius: 9px;
  background: rgba(67, 160, 223, 0.12);
  color: #dff4ff;
  cursor: pointer;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.service {
  padding: 17px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 13px;
  background: rgba(2, 10, 17, 0.42);
}

.service p {
  margin: 5px 0 0;
  color: #768c9c;
  font-size: 13px;
}

.status {
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.status.online {
  background: rgba(58, 193, 121, 0.14);
  color: #71e2a4;
}

.status.offline {
  background: rgba(226, 76, 76, 0.15);
  color: #ff8b8b;
}

.status.pending {
  background: rgba(229, 168, 75, 0.12);
  color: #efbf78;
}

.gpu-summary {
  color: #8ca2b2;
  font-size: 13px;
}

.gpu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.gpu-card {
  padding: 20px;
  border: 1px solid rgba(110, 198, 255, 0.12);
  border-radius: 16px;
  background:
    linear-gradient(145deg,
      rgba(13, 31, 46, 0.94),
      rgba(5, 17, 27, 0.94));
}

.gpu-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.gpu-index {
  margin: 0 0 6px;
  color: #63c3ff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.gpu-name {
  margin: 0;
  font-size: 17px;
  line-height: 1.35;
}

.gpu-health {
  flex-shrink: 0;
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: #45d58b;
  box-shadow: 0 0 13px rgba(69, 213, 139, 0.8);
}

.metric {
  margin-top: 17px;
}

.metric-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  color: #91a7b7;
  font-size: 12px;
}

.metric-heading strong {
  color: #e6f3fb;
  font-size: 13px;
}

.progress-track {
  overflow: hidden;
  height: 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #278ed0, #65c9ff);
  transition: width 0.45s ease;
}

.progress-fill.memory {
  background: linear-gradient(90deg, #6558d8, #aa8cff);
}

.gpu-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 20px;
}

.gpu-stat {
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 11px;
  background: rgba(0, 0, 0, 0.16);
}

.gpu-stat-label {
  display: block;
  margin-bottom: 5px;
  color: #718899;
  font-size: 11px;
}

.gpu-stat-value {
  font-size: 15px;
  font-weight: 750;
}

.loading-card,
.gpu-error {
  grid-column: 1 / -1;
  color: #8298a8;
  text-align: center;
}

.gpu-error {
  padding: 26px;
  border: 1px solid rgba(226, 76, 76, 0.2);
  border-radius: 14px;
  background: rgba(226, 76, 76, 0.06);
  color: #ff9b9b;
}

.hermes-live-state {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #91a7b7;
  font-size: 13px;
}

.activity-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #e5a84b;
  box-shadow: 0 0 13px rgba(229, 168, 75, 0.7);
}

.activity-dot.online {
  background: #45d58b;
  box-shadow: 0 0 13px rgba(69, 213, 139, 0.8);
}

.activity-dot.busy {
  background: #68c7ff;
  box-shadow: 0 0 16px rgba(104, 199, 255, 0.95);
  animation: activity-pulse 1.2s infinite;
}

.activity-dot.offline {
  background: #ef6262;
  box-shadow: 0 0 13px rgba(239, 98, 98, 0.75);
}

.hermes-activity-grid {
  display: grid;
  grid-template-columns: 1.5fr repeat(2, minmax(150px, 0.75fr));
  gap: 14px;
}

.activity-primary-card,
.activity-stat-card,
.activity-details-card {
  border: 1px solid rgba(103, 196, 255, 0.11);
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      rgba(13, 31, 46, 0.92),
      rgba(4, 15, 24, 0.92)
    );
}

.activity-primary-card {
  grid-row: span 2;
  padding: 22px;
}

.activity-primary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
}

.activity-label {
  margin: 0 0 8px;
  color: #6fc7ff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

#hermes-current-state {
  font-size: 24px;
}

.activity-description {
  margin: 18px 0 0;
  color: #8298a8;
  font-size: 13px;
  line-height: 1.6;
}

.activity-animation {
  display: flex;
  align-items: flex-end;
  gap: 5px;
  height: 44px;
  margin-top: 28px;
}

.activity-animation span {
  width: 7px;
  height: 18px;
  border-radius: 999px;
  background: linear-gradient(#6ed2ff, #3b82f6);
  opacity: 0.35;
}

.hermes-activity-panel.is-busy .activity-animation span {
  animation: agent-wave 1s ease-in-out infinite;
  opacity: 1;
}

.hermes-activity-panel.is-busy .activity-animation span:nth-child(2) {
  animation-delay: 0.1s;
}

.hermes-activity-panel.is-busy .activity-animation span:nth-child(3) {
  animation-delay: 0.2s;
}

.hermes-activity-panel.is-busy .activity-animation span:nth-child(4) {
  animation-delay: 0.3s;
}

.hermes-activity-panel.is-busy .activity-animation span:nth-child(5) {
  animation-delay: 0.4s;
}

.activity-stat-card {
  min-height: 126px;
  padding: 18px;
}

.activity-stat-card strong {
  display: block;
  margin-bottom: 8px;
  overflow-wrap: anywhere;
  font-size: 24px;
}

.activity-stat-card > span {
  color: #748a9a;
  font-size: 12px;
}

.activity-details-card {
  display: grid;
  grid-column: span 2;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  overflow: hidden;
}

.activity-detail {
  padding: 18px;
  background: rgba(0, 0, 0, 0.09);
}

.activity-detail span {
  display: block;
  margin-bottom: 7px;
  color: #718899;
  font-size: 11px;
}

.activity-detail strong {
  overflow-wrap: anywhere;
  font-size: 14px;
}

@keyframes activity-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.75;
  }

  50% {
    transform: scale(1.45);
    opacity: 1;
  }
}

@keyframes agent-wave {
  0%,
  100% {
    height: 14px;
  }

  50% {
    height: 42px;
  }
}

.mission-console {
  margin-bottom: 22px;
  padding: 26px;
  border: 1px solid rgba(94, 195, 255, 0.18);
  border-radius: 18px;
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(47, 137, 199, 0.16),
      transparent 24rem
    ),
    linear-gradient(
      145deg,
      rgba(11, 30, 45, 0.96),
      rgba(4, 15, 24, 0.96)
    );
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.22),
    inset 0 1px rgba(255, 255, 255, 0.025);
}

.mission-console-heading,
.mission-controls,
.mission-actions,
.mission-console-state,
.mission-timeline-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mission-console-heading {
  margin-bottom: 22px;
}

.mission-console-state {
  justify-content: flex-end;
  gap: 9px;
  color: #91a7b7;
  font-size: 13px;
}

#mission-console-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #45d58b;
  box-shadow: 0 0 13px rgba(69, 213, 139, 0.75);
}

#mission-console-dot.busy {
  background: #68c7ff;
  box-shadow: 0 0 15px rgba(104, 199, 255, 0.9);
  animation: activity-pulse 1.2s infinite;
}

#mission-console-dot.error {
  background: #ef6262;
  box-shadow: 0 0 13px rgba(239, 98, 98, 0.75);
}

#mission-form > label,
.mission-type-field label {
  display: block;
  margin-bottom: 8px;
  color: #8da5b6;
  font-size: 12px;
  font-weight: 700;
}

#mission-command {
  width: 100%;
  min-height: 118px;
  padding: 16px;
  resize: vertical;
  border: 1px solid rgba(109, 196, 251, 0.18);
  border-radius: 13px;
  outline: none;
  background: rgba(0, 8, 14, 0.48);
  color: #e8f1f7;
  font: inherit;
  line-height: 1.55;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

#mission-command:focus {
  border-color: rgba(103, 199, 255, 0.58);
  box-shadow: 0 0 0 3px rgba(76, 174, 235, 0.1);
}

#mission-command::placeholder {
  color: #5f7687;
}

.mission-controls {
  align-items: flex-end;
  gap: 20px;
  margin-top: 15px;
}

.mission-type-field {
  width: min(300px, 100%);
}

#mission-type {
  width: 100%;
  padding: 11px 13px;
  border: 1px solid rgba(109, 196, 251, 0.18);
  border-radius: 10px;
  outline: none;
  background: #071722;
  color: #dcecf5;
}

.mission-actions {
  justify-content: flex-end;
  gap: 15px;
}

#mission-character-count {
  color: #6f8697;
  font-size: 12px;
}

#execute-mission-button {
  min-width: 160px;
  border-color: rgba(95, 196, 255, 0.6);
  background:
    linear-gradient(
      135deg,
      rgba(36, 132, 196, 0.78),
      rgba(58, 95, 202, 0.78)
    );
  font-weight: 750;
  box-shadow: 0 8px 24px rgba(33, 121, 183, 0.18);
}

#execute-mission-button:hover {
  filter: brightness(1.12);
}

#execute-mission-button:disabled {
  cursor: not-allowed;
  filter: grayscale(0.45);
  opacity: 0.65;
}

.mission-feedback {
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 13px;
}

.mission-feedback.success {
  border: 1px solid rgba(69, 213, 139, 0.22);
  background: rgba(69, 213, 139, 0.08);
  color: #83e8ad;
}

.mission-feedback.error {
  border: 1px solid rgba(239, 98, 98, 0.23);
  background: rgba(239, 98, 98, 0.08);
  color: #ff9c9c;
}

.current-mission-panel {
  margin-bottom: 22px;
}

.mission-history-panel {
  margin-bottom: 22px;
}

.mission-history-controls {
  display: flex;
  align-items: center;
  gap: 14px;
  color: #8298a8;
  font-size: 12px;
}

.mission-history-list {
  display: grid;
  gap: 12px;
}

.mission-history-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  padding: 17px;
  border: 1px solid rgba(105, 195, 251, 0.09);
  border-radius: 13px;
  background: rgba(1, 10, 17, 0.34);
  cursor: pointer;
  transition:
    border-color 0.2s ease,
    transform 0.2s ease,
    background 0.2s ease;
}

.mission-history-item:hover {
  transform: translateY(-1px);
  border-color: rgba(105, 195, 251, 0.28);
  background: rgba(8, 24, 36, 0.58);
}

.mission-history-main {
  min-width: 0;
}

.mission-history-type {
  margin: 0 0 7px;
  color: #67c5ff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mission-history-command {
  margin: 0;
  overflow: hidden;
  color: #dceaf3;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-history-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 9px;
  color: #718899;
  font-size: 11px;
}

.mission-history-status {
  align-self: center;
}

.mission-history-empty {
  padding: 28px;
  border: 1px dashed rgba(255, 255, 255, 0.1);
  border-radius: 13px;
  color: #748b9b;
  text-align: center;
}

.mission-empty-state {
  padding: 25px;
  border: 1px dashed rgba(255, 255, 255, 0.1);
  border-radius: 13px;
  color: #748b9b;
  text-align: center;
}

.mission-empty-state p {
  margin: 0;
}

.mission-content {
  display: grid;
  gap: 18px;
}

.mission-summary,
.mission-timeline-section {
  padding: 20px;
  border: 1px solid rgba(107, 195, 250, 0.1);
  border-radius: 14px;
  background: rgba(1, 10, 17, 0.35);
}

#current-mission-command {
  margin: 0;
  font-size: 18px;
  line-height: 1.5;
}

.mission-metadata {
  display: grid;
  grid-template-columns: 1fr 1.6fr 1fr;
  gap: 12px;
  margin-top: 20px;
}

.mission-metadata div {
  padding: 13px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.12);
}

.mission-metadata span {
  display: block;
  margin-bottom: 6px;
  color: #718899;
  font-size: 11px;
}

.mission-metadata strong {
  display: block;
  overflow-wrap: anywhere;
  font-size: 13px;
}

.mission-timeline-heading {
  margin-bottom: 16px;
}

.secondary-button {
  padding: 8px 13px;
  border-color: rgba(239, 98, 98, 0.32);
  background: rgba(239, 98, 98, 0.07);
  color: #ff9c9c;
}

.mission-timeline {
  display: grid;
  gap: 12px;
}

.mission-event {
  display: grid;
  grid-template-columns: 14px 1fr auto;
  align-items: start;
  gap: 11px;
  padding: 13px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
}

.mission-event:last-child {
  border-bottom: 0;
}

.mission-event-dot {
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: #68c7ff;
  box-shadow: 0 0 9px rgba(104, 199, 255, 0.55);
}

.mission-event.success .mission-event-dot {
  background: #45d58b;
  box-shadow: 0 0 9px rgba(69, 213, 139, 0.55);
}

.mission-event.warning .mission-event-dot {
  background: #e5a84b;
  box-shadow: 0 0 9px rgba(229, 168, 75, 0.55);
}

.mission-event.error .mission-event-dot {
  background: #ef6262;
  box-shadow: 0 0 9px rgba(239, 98, 98, 0.55);
}

.mission-event-message {
  color: #c9dae4;
  font-size: 13px;
  line-height: 1.45;
}

.mission-event-time {
  color: #667d8d;
  font-size: 11px;
  white-space: nowrap;
}

@media (max-width: 1050px) {
  .status-grid,
  .gpu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hermes-activity-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .activity-primary-card {
    grid-column: 1 / -1;
    grid-row: auto;
  }

  .activity-details-card {
    grid-column: 1 / -1;
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: static;
    width: auto;
  }

  main {
    margin-left: 0;
  }

  .status-grid,
  .service-grid
  .gpu-grid {
    grid-template-columns: 1fr;
  }

  .hermes-activity-grid,
  .activity-details-card {
    grid-template-columns: 1fr;
  }

  .activity-details-card {
    grid-column: auto;
  }

  .mission-controls,
  .mission-actions,
  .mission-console-heading,
  .mission-timeline-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .mission-type-field {
    width: 100%;
  }

  .mission-actions {
    gap: 10px;
  }

  #execute-mission-button {
    width: 100%;
  }

  .mission-metadata {
    grid-template-columns: 1fr;
  }

  .mission-event {
    grid-template-columns: 12px 1fr;
  }

  .mission-event-time {
    grid-column: 2;
  }

  .mission-history-controls {
    align-items: stretch;
    flex-direction: column;
  }

  .mission-history-item {
    grid-template-columns: 1fr;
  }

  .mission-history-status {
    justify-self: start;
  }
}
