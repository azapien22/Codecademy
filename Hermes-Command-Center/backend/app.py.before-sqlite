    "/static",
    StaticFiles(directory=FRONTEND_DIR),
    name="static",
)

MissionStatus = Literal[
    "accepted",
    "queued",
    "running",
    "stopping",
    "completed",
    "failed",
    "cancelled",
]


class MissionRequest(BaseModel):
    command: str = Field(
        ...,
        min_length=3,
        max_length=4000,
        description="Natural-language mission for Specterman_AI.",
    )

    mission_type: str = Field(
        default="general",
        min_length=1,
        max_length=100,
    )


class MissionEvent(BaseModel):
    timestamp: str
    message: str
    level: Literal["info", "success", "warning", "error"] = "info"


class Mission(BaseModel):
    id: str
    command: str
    mission_type: str
    status: MissionStatus
    created_at: str
    updated_at: str
    events: list[MissionEvent]

    hermes_run_id: str | None = None
    hermes_session_id: str | None = None
    output: str | None = None
    error: str | None = None


missions: dict[str, Mission] = {}
current_mission_id: str | None = None
mission_tasks: dict[str, asyncio.Task] = {}


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def add_mission_event(
    mission: Mission,
    message: str,
    level: Literal["info", "success", "warning", "error"] = "info",
) -> None:
    mission.events.append(
        MissionEvent(
            timestamp=utc_now(),
            message=message,
            level=level,
        )
    )

    mission.updated_at = utc_now()


def hermes_headers() -> dict[str, str]:
    if not HERMES_API_KEY:
        raise RuntimeError(
            "API_SERVER_KEY was not loaded from ~/.hermes/.env."
        )

    return {
        "Authorization": f"Bearer {HERMES_API_KEY}",
        "Content-Type": "application/json",
    }


def mission_instructions(mission: Mission) -> str:
    safety_rules = (
        "You are executing a mission submitted through the "
        "Specterman_AI Command Center. "
        "Report a concise final result. "
        "Do not delete files, alter critical system configuration, "
        "install software, send messages, publish content, or perform "
        "other destructive or irreversible actions unless the mission "
        "explicitly authorizes that exact action."
    )

    type_instructions = {
        "image-generation": (
            "Use the existing local ComfyUI integration when image "
            "generation is requested. Do not install models or modify "
            "ComfyUI unless explicitly requested."
        ),
        "research": (
            "Perform careful research and clearly distinguish confirmed "
            "facts from assumptions."
        ),
        "coding": (
            "Inspect the relevant project before modifying it. Preserve "
            "existing behavior and report files changed."
        ),
        "system": (
            "Prefer inspection and diagnostics before making changes. "
            "Avoid destructive system actions without explicit approval."
        ),
        "document": (
            "Create the requested document and report its exact output "
            "location."
        ),
        "general": (
            "Choose the most appropriate available tools for the task."
        ),
    }

    return (
        safety_rules
        + " "
        + type_instructions.get(
            mission.mission_type,
            type_instructions["general"],
        )
    )


async def dispatch_mission_to_hermes(mission_id: str) -> None:
    mission = missions.get(mission_id)

    if mission is None:
        return

    mission.status = "queued"
    add_mission_event(
        mission,
        "Preparing mission for Hermes dispatch.",
        "info",
    )

    session_id = f"specterman-{mission.id}"
    mission.hermes_session_id = session_id

    try:
        async with httpx.AsyncClient(timeout=30.0) as client:
            response = await client.post(
                f"{HERMES_API_BASE_URL}/v1/runs",
                headers=hermes_headers(),
                json={
                    "input": mission.command,
                    "session_id": session_id,
                    "instructions": mission_instructions(mission),
                },
            )

            response.raise_for_status()
            run_data = response.json()

        run_id = run_data.get("run_id")

        if not run_id:
            raise RuntimeError(
                "Hermes accepted the request but returned no run_id."
            )

        mission.hermes_run_id = run_id
        mission.status = "running"

        add_mission_event(
            mission,
            f"Hermes run started: {run_id}",
            "success",
        )

        await monitor_hermes_run(mission_id)

    except asyncio.CancelledError:
        raise

    except Exception as exc:
        mission.status = "failed"
        mission.error = str(exc)

        add_mission_event(
            mission,
            f"Hermes dispatch failed: {exc}",
            "error",
        )


async def monitor_hermes_run(mission_id: str) -> None:
    mission = missions.get(mission_id)

    if mission is None or not mission.hermes_run_id:
        return

    run_id = mission.hermes_run_id
    previous_status: str | None = None

    while True:
        await asyncio.sleep(2)

        try:
            async with httpx.AsyncClient(timeout=15.0) as client:
                response = await client.get(
                    f"{HERMES_API_BASE_URL}/v1/runs/{run_id}",
                    headers=hermes_headers(),
                )

                response.raise_for_status()
                run_data = response.json()

        except asyncio.CancelledError:
            raise

        except Exception as exc:
            mission.status = "failed"
            mission.error = str(exc)

            add_mission_event(
                mission,
                f"Unable to monitor Hermes run: {exc}",
                "error",
            )
            return

        hermes_status = run_data.get("status", "unknown")

        if hermes_status != previous_status:
            previous_status = hermes_status

            if hermes_status not in {"completed", "failed", "cancelled"}:
                add_mission_event(
                    mission,
                    f"Hermes run status: {hermes_status}.",
                    "info",
                )

        if hermes_status in {"started", "queued", "running"}:
            mission.status = "running"
            mission.updated_at = utc_now()
            continue

        if hermes_status == "stopping":
            mission.status = "stopping"
            mission.updated_at = utc_now()
            continue

        if hermes_status == "completed":
            mission.status = "completed"
            mission.output = run_data.get("output")

            add_mission_event(
                mission,
                "Hermes completed the mission successfully.",
                "success",
            )

            if mission.output:
                add_mission_event(
                    mission,
                    f"Result: {mission.output}",
                    "success",
                )

            return

        if hermes_status == "cancelled":
            mission.status = "cancelled"

            add_mission_event(
                mission,
                "Hermes confirmed that the mission was cancelled.",
                "warning",
            )
            return

        if hermes_status == "failed":
            mission.status = "failed"

            error_value = run_data.get("error")
            mission.error = (
                str(error_value)
                if error_value
                else "Hermes run failed."
            )

            add_mission_event(
                mission,
                f"Hermes mission failed: {mission.error}",
                "error",
            )
            return

        mission.status = "failed"
        mission.error = (
            f"Hermes returned an unexpected run status: "
            f"{hermes_status}"
        )

        add_mission_event(
            mission,
            mission.error,
            "error",
        )
        return


def remove_finished_mission_task(
    mission_id: str,
) -> None:
    mission_tasks.pop(mission_id, None)


