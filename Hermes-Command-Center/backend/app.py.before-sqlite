load_dotenv(HERMES_ENV_PATH)

HERMES_API_BASE_URL = "http://127.0.0.1:8642"
HERMES_API_KEY = os.getenv("API_SERVER_KEY")

app = FastAPI(
    title="Hermes Command Center",
    description="Local AI workstation monitoring and control dashboard.",
    version="0.1.0",
)

