    )
    ollama = await check_http_service(
        "http://127.0.0.1:11434/api/tags"
    )

    return {
        "comfyui": comfyui,
        "ollama": ollama,
    }

@app.get("/api/gpus")
async def gpu_status() -> dict:
    command = [
        "nvidia-smi",
        "--query-gpu="
        "index,"
        "name,"
        "utilization.gpu,"
        "memory.used,"
        "memory.total,"
        "temperature.gpu,"
        "power.draw,"
        "power.limit",
        "--format=csv,noheader,nounits",
    ]

    try:
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )

        stdout, stderr = await process.communicate()

        if process.returncode != 0:
            return {
                "online": False,
                "gpus": [],
                "error": stderr.decode().strip() or "nvidia-smi failed",
            }

        output = stdout.decode().strip()
        reader = csv.reader(io.StringIO(output))

        gpus = []

        for row in reader:
            if len(row) != 8:
                continue

            index = int(row[0].strip())
            name = row[1].strip()
            utilization = float(row[2].strip())
            memory_used_mb = float(row[3].strip())
            memory_total_mb = float(row[4].strip())
            temperature_c = float(row[5].strip())
            power_draw_w = parse_optional_number(row[6])
            power_limit_w = parse_optional_number(row[7])

            memory_percent = (
                round((memory_used_mb / memory_total_mb) * 100, 1)
                if memory_total_mb > 0
                else 0
            )

            gpus.append(
                {
                    "index": index,
                    "name": name,
                    "utilization_percent": utilization,
                    "memory": {
                        "used_mb": memory_used_mb,
                        "total_mb": memory_total_mb,
                        "used_gb": round(memory_used_mb / 1024, 2),
                        "total_gb": round(memory_total_mb / 1024, 2),
                        "usage_percent": memory_percent,
                    },
                    "temperature_c": temperature_c,
                    "power": {
                        "draw_w": power_draw_w,
                        "limit_w": power_limit_w,
                    },
                }
            )

        return {
            "online": True,
            "count": len(gpus),
            "gpus": gpus,
        }

    except FileNotFoundError:
        return {
            "online": False,
            "gpus": [],
            "error": "nvidia-smi was not found.",
        }
    except Exception as exc:
        return {
            "online": False,
            "gpus": [],
            "error": str(exc),
        }


def parse_optional_number(value: str) -> float | None:
    cleaned = value.strip()

    if cleaned in {"N/A", "[N/A]", "Not Supported"}:
        return None

    try:
        return round(float(cleaned), 1)
    except ValueError:
        return None


@app.get("/api/hermes")
async def hermes_status() -> dict:
    url = "http://127.0.0.1:9119/api/status"

    try:
        async with httpx.AsyncClient(timeout=3.0) as client:
            response = await client.get(url)
            response.raise_for_status()

        data = response.json()
        telegram = data.get("gateway_platforms", {}).get("telegram", {})

        return {
            "online": True,
            "version": data.get("version"),
            "release_date": data.get("release_date"),
            "gateway": {
                "running": data.get("gateway_running", False),
                "state": data.get("gateway_state", "unknown"),
                "pid": data.get("gateway_pid"),
                "busy": data.get("gateway_busy", False),
            },
            "telegram": {
                "state": telegram.get("state", "unknown"),
                "connected": telegram.get("state") == "connected",
                "error_message": telegram.get("error_message"),
            },
            "agents": {
                "active": data.get("active_agents", 0),
                "sessions": data.get("active_sessions", 0),
            },
            "profile": (
                data.get("profiles", ["default"])[0]
                if data.get("profiles")
                else "default"
            ),
        }

    except httpx.HTTPStatusError as exc:
        return {
            "online": False,
            "error": f"Hermes returned HTTP {exc.response.status_code}",
        }
    except httpx.HTTPError as exc:
        return {
            "online": False,
            "error": str(exc),
        }
    except ValueError:
        return {
            "online": False,
            "error": "Hermes returned invalid JSON.",
        }


@app.post("/api/missions", status_code=201)
async def create_mission(request: MissionRequest) -> Mission:
    global current_mission_id

    mission_id = str(uuid4())
    timestamp = utc_now()

    mission = Mission(
        id=mission_id,
        command=request.command.strip(),
        mission_type=request.mission_type.strip() or "general",
        status="accepted",
        created_at=timestamp,
        updated_at=timestamp,
        events=[],
    )

    add_mission_event(
        mission,
        "Mission received by Specterman_AI Command Center.",
        "success",
    )

    add_mission_event(
        mission,
        "Mission accepted and awaiting Hermes dispatch.",
        "info",
    )

    missions[mission_id] = mission
    current_mission_id = mission_id

    task = asyncio.create_task(
        dispatch_mission_to_hermes(mission_id)
    )

    mission_tasks[mission_id] = task

    task.add_done_callback(
        lambda _: remove_finished_mission_task(mission_id)
    )

    return mission


@app.get("/api/missions/current")
async def get_current_mission() -> Mission | None:
    if current_mission_id is None:
        return None

    return missions.get(current_mission_id)


@app.get("/api/missions/{mission_id}")
async def get_mission(mission_id: str) -> Mission:
    mission = missions.get(mission_id)

    if mission is None:
        raise HTTPException(
            status_code=404,
            detail="Mission not found.",
        )

    return mission


@app.get("/api/missions")
async def list_missions() -> dict:
    ordered_missions = sorted(
        missions.values(),
        key=lambda mission: mission.created_at,
        reverse=True,
    )

    return {
        "count": len(ordered_missions),
        "missions": ordered_missions,
    }


@app.post("/api/missions/{mission_id}/cancel")
async def cancel_mission(mission_id: str) -> Mission:
    mission = missions.get(mission_id)

    if mission is None:
        raise HTTPException(
            status_code=404,
            detail="Mission not found.",
        )

    if mission.status in {"completed", "failed", "cancelled"}:
        raise HTTPException(
            status_code=409,
            detail=f"Mission is already {mission.status}.",
        )

    if not mission.hermes_run_id:
        mission.status = "cancelled"

        task = mission_tasks.get(mission_id)

        if task and not task.done():
            task.cancel()

        add_mission_event(
            mission,
            "Mission cancelled before Hermes dispatch completed.",
            "warning",
        )

        return mission

    try:
        async with httpx.AsyncClient(timeout=15.0) as client:
            response = await client.post(
                (
                    f"{HERMES_API_BASE_URL}/v1/runs/"
                    f"{mission.hermes_run_id}/stop"
                ),
                headers=hermes_headers(),
            )

            response.raise_for_status()

        mission.status = "stopping"

        add_mission_event(
            mission,
            "Cancellation requested. Waiting for Hermes to stop safely.",
            "warning",
        )

        return mission

    except httpx.HTTPStatusError as exc:
        raise HTTPException(
            status_code=502,
            detail=(
                "Hermes rejected the cancellation request with "
                f"HTTP {exc.response.status_code}."
            ),
        ) from exc

    except Exception as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Unable to stop Hermes run: {exc}",
        ) from exc
